# Copy this file to `.env` and fill in real values. NEVER commit the real .env
# (it's gitignored). Every variable the app reads is documented here (CLAUDE.md §6).

# --- LLM provider ---------------------------------------------------------
# The provider is swapped behind a one-file abstraction (CLAUDE.md §3).
# Provisional provider for the skeleton: Google Gemini free tier (ADR-0005).
LLM_PROVIDER=gemini                 # gemini | openai | azure | local
LLM_API_KEY=                        # SECRET — your Gemini key from https://aistudio.google.com/apikey
LLM_MODEL=gemini-flash-lite-latest  # efficiency-oriented default; verify this project's
                                    # current RPM/TPM/RPD in AI Studio (ADR-0018)
# Decoding is deterministic on purpose (ADR-0012): the bot extracts answers from
# retrieved context rather than writing prose, and a fixed temperature is what makes
# the answer eval reproducible. Raise only if you have a measured reason to.
LLM_TEMPERATURE=0.0
LLM_SEED=42                         # any fixed value; temperature 0 alone did NOT stop
                                    # Gemini varying its wording (measured — see ADR-0012)
LLM_MAX_OUTPUT_TOKENS=1024          # ceiling per answer; caps runaway free-tier spend

# --- Embeddings -----------------------------------------------------------
# Local/open model, no per-token cost, runs offline (CLAUDE.md §3, ADR-0004).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Pinned to an exact HF commit, not just the "v1.5" tag: re-uploaded weights under
# the same tag would silently change the vectors, and since the pgdata volume
# survives image rebuilds you'd end up querying new vectors against an old index —
# no error, just quietly worse retrieval. Changing this requires a full re-ingest.
EMBEDDING_MODEL_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a

# --- Vector store: PostgreSQL + pgvector ----------------------------------
# Host-based dev value (uvicorn running on your machine with a separately exposed
# PostgreSQL). The normal Docker workflow keeps PostgreSQL private and overrides
# this with host "db" automatically.
DATABASE_URL=postgresql://msfea:msfea@localhost:5432/msfea

# --- Retrieval / generation knobs -----------------------------------------
TOP_K=7                             # normal depth; explicit comparisons use at least 12 (ADR-0022)
# Gate on the strongest cosine among retrieved hits, not the first hybrid rank.
# ADR-0022: 109/109 valid calibration queries pass; 11/20 off-topic queries skip
# Gemini. Generation must still refuse relevant but unsupported questions.
# Re-run `python -m eval.threshold_eval` after KB/model changes.
SIMILARITY_THRESHOLD=0.60           # below this, skip the LLM and escalate (§5.6)

# --- Escalation -----------------------------------------------------------
ESCALATION_CONTACT=                # human contact shown when the bot refuses

# --- API / safety (Phase 8) -----------------------------------------------
# Comma-separated origins allowed to embed the widget cross-origin. EMPTY =
# deny all cross-origin (same-origin still works) — the safe default. In
# production set the exact page origin, e.g. https://www.aub.edu.lb . Do NOT use
# "*" in production: it lets any website call your API and drain your LLM quota.
CORS_ALLOW_ORIGINS=
RATE_LIMIT_REQUESTS=20             # max /chat requests per client per window
RATE_LIMIT_WINDOW_SECONDS=60
TRUST_PROXY_HEADERS=false          # true ONLY behind a trusted reverse proxy
WARM_MODELS_ON_STARTUP=false       # Compose overrides true; readiness then includes
                                   # the one-time local embedding/NER model warm-up

# --- Admin dashboard (ADR-0010) -------------------------------------------
# Shared secret protecting /admin endpoints and the dashboard. Empty = admin
# disabled. Set a strong random value in production.
ADMIN_TOKEN=
