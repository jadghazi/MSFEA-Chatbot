# Copy this file to `.env` and fill in real values. NEVER commit the real .env
# (it's gitignored). Every variable the app reads is documented here (CLAUDE.md §6).

# --- LLM provider ---------------------------------------------------------
# The provider is swapped behind a one-file abstraction (CLAUDE.md §3). The
# concrete provider is chosen in the generation phase; until then this is a
# placeholder.
LLM_PROVIDER=placeholder            # e.g. openai | azure | gemini | local
LLM_API_KEY=                        # SECRET — leave blank here, set in real .env
LLM_MODEL=                          # provider-specific model id

# --- Embeddings -----------------------------------------------------------
# Default to a local/open model so there's no per-token cost (CLAUDE.md §3).
# Exact model chosen (with trade-offs) in the ingestion phase.
EMBEDDING_MODEL=                    # e.g. BAAI/bge-small-en-v1.5

# --- Vector store: PostgreSQL + pgvector ----------------------------------
DATABASE_URL=postgresql://msfea:msfea@localhost:5432/msfea

# --- Retrieval / generation knobs -----------------------------------------
TOP_K=5                             # how many chunks to retrieve
SIMILARITY_THRESHOLD=0.0            # below this, skip the LLM and escalate (§5.6)

# --- Escalation -----------------------------------------------------------
ESCALATION_CONTACT=                # human contact shown when the bot refuses
