# Copy this file to `.env` and fill in real values. NEVER commit the real .env
# (it's gitignored). Every variable the app reads is documented here (AGENTS.md §6).

# --- LLM provider ---------------------------------------------------------
# Other vendors require an adapter and verification (AGENTS.md §3).
# Currently implemented provider: Google Gemini (ADR-0005).
LLM_PROVIDER=gemini                 # only Gemini is implemented currently
LLM_API_KEY=                        # SECRET — your Gemini key from https://aistudio.google.com/apikey
LLM_MODEL=gemini-3.8-flash          # paid student candidate; Oracle migration is separate
# Legacy sampling fields apply only when sampling parameters are enabled.
# Temperature/seed reduce variation; they do not guarantee identical outputs.
LLM_TEMPERATURE=0.0
LLM_SEED=42                         # any fixed value; temperature 0 alone did NOT stop
                                    # Gemini varying its wording (measured — see ADR-0012)
LLM_MAX_OUTPUT_TOKENS=4096          # includes thinking tokens and the visible answer
# Measured Gemini 3.8 Flash student profile: sampling=false, thinking=medium,
# with an output ceiling allowing both reasoning and the final answer.
# Staff curation retains its separate existing sampling/medium-thinking profile.
LLM_GEMINI_USE_SAMPLING_PARAMS=false
LLM_GEMINI_THINKING_LEVEL=medium

# Occasional staff reviews use a separate model from student answers.
# Verified project allowance on 2026-10-01: 15 RPM / 500 RPD for 3.1 Flash-Lite.
# Four focused calls for routine preparation; repair adds at most two.
# Adjust these to YOUR project's AI Studio limits; other usage shares the quota.
CURATION_LLM_MODEL=gemini-3.1-flash-lite
CURATION_LLM_DAILY_CALL_LIMIT=400
CURATION_LLM_REQUESTS_PER_MINUTE=12
# Two actual answer previews use LLM_MODEL; reserve most of its quota for students.
CURATION_PREVIEW_DAILY_CALL_LIMIT=60

# --- Embeddings -----------------------------------------------------------
# Local/open model, no per-token cost, runs offline (AGENTS.md §3, ADR-0004).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Pinned to an exact HF commit, not just the "v1.5" tag: re-uploaded weights under
# the same tag would silently change the vectors, and since the pgdata volume
# survives image rebuilds you'd end up querying new vectors against an old index —
# no error, just quietly worse retrieval. Changing this requires a full re-ingest.
EMBEDDING_MODEL_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a

# --- Vector store: PostgreSQL + pgvector ----------------------------------
# Host-based dev value (uvicorn running on your machine with a separately exposed
# PostgreSQL). The normal Docker workflow keeps PostgreSQL private and overrides
# this with host "db" automatically.
DATABASE_URL=postgresql://msfea:msfea@localhost:5432/msfea
# Separate PostgreSQL database used only for draft validation (required to validate).
VALIDATION_DATABASE_URL=postgresql://msfea:msfea@localhost:5432/msfea_validation
# Exact deployed Git commit included in validation fingerprints.
APP_COMMIT=
# Dedicated, independent secrets for app↔worker and app→n8n calls. Generate each
# with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CURATION_WORKER_TOKEN=
N8N_WEBHOOK_SECRET=
# n8n uses a separate PostgreSQL service/user and persistent encryption key.
N8N_DB_PASSWORD=
N8N_ENCRYPTION_KEY=
# Required only with docker-compose.prod.yml (Caddy public hostname).
DOMAIN=
N8N_BASE_URL=http://n8n:5678
APP_INTERNAL_URL=http://app:8000
CURATION_OUTBOX_MAX_ATTEMPTS=8
CURATION_VALIDATION_TIMEOUT_MINUTES=60
CURATION_PUBLICATION_TIMEOUT_MINUTES=60

# --- Retrieval / generation knobs -----------------------------------------
TOP_K=7                             # normal depth; explicit comparisons use at least 12 (ADR-0022)
# Gate on the strongest cosine among retrieved hits, not the first hybrid rank.
# The threshold is calibrated independently of generation (ADR-0020/0022).
# Generation must still refuse relevant but unsupported questions.
# Re-run `python -m eval.threshold_eval` after KB/model changes.
SIMILARITY_THRESHOLD=0.60           # below this, skip the LLM and escalate (§5.6)

# --- Escalation -----------------------------------------------------------
ESCALATION_CONTACT=                # human contact shown when the bot refuses

# --- API / safety (Phase 8) -----------------------------------------------
# Comma-separated origins allowed to embed the widget cross-origin. EMPTY =
# deny all cross-origin (same-origin still works) — the safe default. In
# production set the exact page origin, e.g. https://www.aub.edu.lb . Do NOT use
# "*" in production: it lets any website call your API and drain your LLM quota.
CORS_ALLOW_ORIGINS=
RATE_LIMIT_REQUESTS=60             # per IP; shared campus networks need headroom
RATE_LIMIT_WINDOW_SECONDS=60
TRUST_PROXY_HEADERS=false          # true ONLY behind a trusted reverse proxy
WARM_MODELS_ON_STARTUP=false       # Compose overrides true; readiness then includes
                                   # the one-time local embedding/NER model warm-up

# --- Admin dashboard (ADR-0010) -------------------------------------------
# Shared secret protecting /admin endpoints and the dashboard. Empty = admin
# disabled. Set a strong random value in production.
ADMIN_TOKEN=

# Single-worker usage guards: 12 requests/5s and 300/hour per IP;
# 20/minute and 80/hour per browser session. 1 active request/session,
# 4/IP, 16 globally. Exact-context responses replay for 30s within a session.
# See docs/deployment.md before changing worker count or proxy topology.
